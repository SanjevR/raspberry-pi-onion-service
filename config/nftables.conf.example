#!/usr/sbin/nft -f

flush ruleset

table inet filter {
    chain input {
        type filter hook input priority 0;
        policy drop;

        ct state established,related accept
        ct state invalid drop
        iifname "lo" accept

        # Replace with the trusted local subnet used for administration.
        ip saddr 192.168.50.0/24 tcp dport 22 accept

        # IPv6 neighbor discovery and essential ICMPv6.
        meta l4proto ipv6-icmp accept

        # DHCP client traffic.
        udp sport 67 udp dport 68 accept
        udp sport 547 udp dport 546 accept

        # mDNS for a local hostname such as onionserver.local.
        udp dport 5353 accept
    }

    chain forward {
        type filter hook forward priority 0;
        policy drop;
    }

    chain output {
        type filter hook output priority 0;
        policy accept;
    }
}
